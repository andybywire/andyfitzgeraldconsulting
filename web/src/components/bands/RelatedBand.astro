---
/**
 * The "Related" band — every insight and presentation detail page.
 *
 * Ranking happens in `lib/related.ts`; this component receives an ordered list and renders
 * it. It does own one piece of logic, the heading, because that is presentation: the band
 * says *Related* when the ranker found real matches and *Recent* when it fell through to the
 * date fallback, and putting that split in the page would make every consumer restate it.
 *
 * ── THE HEADING NAMES WHAT THE CARDS ARE, READ OFF THE CARDS ─────────────────
 *
 * Since lists cross (2026-10-28), the heading names the page's own category first and the
 * other one too when a card came from it: "Related Insights & Presentations". That is read
 * from the cards' own `_type`s rather than from the ranker's `crossed` count, so the heading
 * cannot name a category no card on screen belongs to. The fallback is home-only, so it
 * always reads "Recent Insights" or "Recent Presentations".
 *
 * ── THE SAME CARDS AS THE INDEX, AT h3 ───────────────────────────────────────
 *
 * A detail page's h1 is the article title and this band's own heading is an h2, so the card
 * titles sit at h3 — one level below the index, where they are h2 under the page h1.
 */
import type {SanityImageSource} from '../../sanity/image'
import {categoryForType, type Category} from '../../lib/related'
import Band from '../Band.astro'
import Grid from '../Grid.astro'
import ArticleCard from '../cards/ArticleCard.astro'
import NoteCard from '../cards/NoteCard.astro'
import PresentationCard from '../cards/PresentationCard.astro'
import {
  presentationTags,
  presentationVenueLine,
  type PresentationVenue,
} from '../cards/presentationCard'

export type RelatedItem = {
  _id: string
  _type?: string | null
  slug?: string | null
  title?: string | null
  genre?: string | null
  pubDate?: string | null
  shortDescription?: string | null
  heroImage?: SanityImageSource | null
  sourceDomain?: string | null
  /* Presentation-only, and null on every other row. RELATED_POOL_QUERY projects these
     flat rather than behind a `_type ==` conditional, so TypeGen returns one union
     discriminated on `_type` whose article members type these as literal `null` — which
     is both honest and directly assignable here. */
  poster?: SanityImageSource | null
  venue?: PresentationVenue | null
  eventCount?: number | null
  hasTranscript?: boolean | null
  hasDeck?: boolean | null
  recordingKinds?: (string | null)[] | null
}

/** Each category's name in the heading, and where its documents live (no trailing slash). */
const COLLECTIONS: Record<Category, {noun: string; path: string}> = {
  insights: {noun: 'Insights', path: '/insights'},
  presentations: {noun: 'Presentations', path: '/presentations'},
}

interface Props {
  /**
   * The category of the page doing the linking, which the heading names first.
   *
   * ── A CARD'S LINK IS A FACT ABOUT THE ROW NOW, NOT THE PAGE ─────────────────
   *
   * This prop was `basePath`, and its comment said the opposite: the collection a link
   * belongs to is a fact about the PAGE, matching the chain <EntryHeader>, <TopicList> and
   * <Eyebrow> use. That held while a list drew from one collection. Once lists cross
   * (lib/related.ts → rankAcross), an insight page can show a presentation card, and no one
   * path is right for every card — so each card links to the collection its own document
   * lives in, from its `_type`, and the page says only which category is home.
   *
   * The chain is unaffected, and the difference is real rather than drift: a topic or genre
   * link there filters the page's OWN index, so for it the collection really is the page's.
   */
  category: Category
  /** The ranker found nothing, so these are simply the most recent documents in `category`. */
  isFallback?: boolean
  items: RelatedItem[]
}

const {category, isFallback = false, items}: Props = Astro.props

/* `_type` is optional in the item's shape only. IDENTITY projects it on every pool row. */
const categoryOf = (item: RelatedItem) => categoryForType(item._type ?? '')
const href = (item: RelatedItem) => `${COLLECTIONS[categoryOf(item)].path}/${item.slug}/`

const crossedFrom = items.map(categoryOf).find((c) => c !== category)
const nouns = [category, crossedFrom].flatMap((c) => (c ? [COLLECTIONS[c].noun] : [])).join(' & ')
const heading = `${isFallback ? 'Recent' : 'Related'} ${nouns}`
---

{
  /*
  `space="section"` for the board's 96, clamping to 64 at 375 — both measured. The tone is
  the default `page`: the board draws this band on the page ground with white cards, the
  same figure-on-ground the index masonry uses, so it sets no background of its own.
*/
}
<Band space="section" aria-labelledby="related-band">
  <Grid class="related-grid">
    <h2 id="related-band" class="related-title">{heading}</h2>

    <ul class="related-cards" role="list">
      {
        items.map((item) => (
          <li>
            {item._type === 'presentation' ? (
              /* The same card the Presentations index renders, with the venue line and
                 the tag row built by the same two functions — which is what keeps `+N`,
                 the tag order and the `online` rule from drifting between the two. The
                 board draws this card bare here, without poster or tags; Andy's call
                 (2026-09-11) was to follow the index instead, so one card type behaves
                 the same wherever it appears. */
              <PresentationCard
                as="h3"
                href={href(item)}
                title={item.title ?? 'Untitled'}
                genre={item.genre}
                date={item.pubDate}
                venue={presentationVenueLine(item)}
                poster={item.poster}
                tags={presentationTags(item)}
              />
            ) : item._type === 'note' ? (
              <NoteCard
                as="h3"
                href={href(item)}
                title={item.title ?? 'Untitled'}
                genre={item.genre}
                date={item.pubDate}
                description={item.shortDescription}
                sourceDomain={item.sourceDomain ?? null}
              />
            ) : (
              <ArticleCard
                as="h3"
                href={href(item)}
                title={item.title ?? 'Untitled'}
                genre={item.genre}
                date={item.pubDate}
                description={item.shortDescription}
                image={item.heroImage}
              />
            )}
          </li>
        ))
      }
    </ul>
  </Grid>
</Band>

<style>
  /*
   * 48 between the heading and the cards, measured identically on the desktop and mobile
   * boards — and NOT the 16 the other two bands use. The difference is real rather than
   * drift: Work with Me and RSS put a heading directly above its own copy, where this one
   * introduces a grid of separate things.
   */
  .related-grid {
    row-gap: var(--rhythm-block);
  }

  .related-title,
  .related-cards {
    grid-column: var(--col-full);
  }

  /*
   * ── THE CARDS ARE THEIR OWN GRID, NOT GRID ITEMS ────────────────────────────
   *
   * Three at `span-4` would place identically on the page grid, but a list of related
   * documents wants to BE a list — so the <ul> takes the full width and lays its own
   * columns out inside it. 996 across three columns with the 24 gutter gives 316 each,
   * which is the card width the board draws and the same one the index masonry uses.
   *
   * `role="list"` because `list-style: none` drops list semantics in Safari.
   */
  .related-cards {
    margin: 0;
    padding: 0;
    list-style: none;

    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--grid-gutter);
    /* 32 between stacked cards, measured off the mobile board — `rhythm-list`, the same
       gap the masonry leaves between cards. */
    row-gap: var(--rhythm-list);

    /*
     * REQUIRED, and for the reason the masonry documents: without it every card stretches
     * to its row's height, which on a note card would reveal its whole hover box at rest.
     * It is also what Andy asked for directly — the cards take the height they need and
     * the bottom edge rags, matching what the masonry above already does.
     */
    align-items: start;
  }

  /* The index ladder, so a related card and an index card behave the same at every width.
     With exactly three cards the middle rung is a row of two and then one. */
  @container style(--breakpoint-md: true) {
    .related-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @container style(--breakpoint-lg: true) {
    .related-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
