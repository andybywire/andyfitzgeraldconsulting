# Copy to `.env` and fill in. The schema that validates these lives in astro.config.mjs
# under `env.schema` — add a field there before adding a variable here.

# Sanity project. `production-26` is the model-iteration dataset; the live site is served
# from `production` by the frozen 11ty build on `main`.
PUBLIC_SANITY_PROJECT_ID=7v0qvet6
PUBLIC_SANITY_DATASET=production-26

# `production` (static, indexed, published content) or `preview` (SSR, noindex, drafts).
# Set by the build scripts, not usually by hand — see package.json.
PUBLIC_SITE_MODE=production

# Where the Studio is hosted, for stega click-to-edit links. Only read in preview mode, and
# not set until studio-next exists in phase 1.
# PUBLIC_SANITY_STUDIO_URL=

# Viewer token, preview environment only. Required to read drafts; a production build must
# succeed without it. Create at https://sanity.io/manage → API → Tokens.
# SANITY_API_READ_TOKEN=
