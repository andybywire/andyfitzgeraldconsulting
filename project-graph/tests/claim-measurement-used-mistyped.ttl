# A measurement that used a mistyped tool concept ("headless-chrom").
# expect: violation "What a measurement used must be a concept"

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#> .
@prefix model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

claim:planted-used-typo a model:Observation ;
  dcterms:subject concept:focus-ring ;
  dcterms:description "Planted: tool typo."@en ;
  prov:wasGeneratedBy [ a model:Measurement ;
    model:method "Planted: looked."@en ;
    prov:used concept:headless-chrom ] .
