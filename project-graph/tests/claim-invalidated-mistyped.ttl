# A measurement that overturned a claim whose slug is mistyped.
# expect: violation "What prov:invalidated points at must be a claim"

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#> .
@prefix model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

claim:planted-overturner a model:Observation ;
  dcterms:subject concept:focus-ring ;
  dcterms:description "Planted: overturns a typo."@en ;
  prov:wasGeneratedBy [ a model:Measurement ;
    model:method "Planted: looked."@en ;
    prov:invalidated claim:planted-no-such-claim ] .
