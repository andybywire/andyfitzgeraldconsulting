# A decision given the observation's basis, model:assumed.
# expect: violation "A decision's only possible basis is model:unattributed"

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#> .
@prefix model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

claim:planted-assumed-decision a model:Decision ;
  dcterms:subject concept:not-applicable ;
  dcterms:description "Planted: wrong basis."@en ;
  model:basis model:assumed .
