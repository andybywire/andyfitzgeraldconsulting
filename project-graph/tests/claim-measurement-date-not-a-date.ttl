# A measurement dated with a string rather than an xsd:date.
# expect: violation "A measurement has at most one dcterms:date"

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#> .
@prefix model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

claim:planted-bad-date a model:Observation ;
  dcterms:subject concept:focus-ring ;
  dcterms:description "Planted: bad date."@en ;
  prov:wasGeneratedBy [ a model:Measurement ;
    model:method "Planted: looked."@en ;
    dcterms:date "Sept 30" ] .
