# A claim typed as an observation and a decision, with backing that would satisfy either.
# expect: violation "exactly one kind"

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#> .
@prefix model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

claim:planted-two-kinds a model:Observation, model:Decision ;
  dcterms:subject concept:focus-ring ;
  dcterms:description "Planted: two kinds."@en ;
  prov:wasGeneratedBy [ a model:Measurement ; model:method "Planted: looked in a browser."@en ] ;
  prov:wasAttributedTo <https://andyfitzgeraldconsulting.com/#person> .
