# One concept's preferred label used as another concept's alternate label.
# expect: violation "also belongs to another concept"

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix scheme: <https://andyfitzgeraldconsulting.com/ns/project-graph/> .

concept:planted-owner a skos:Concept ;
  skos:inScheme scheme:concepts ;
  skos:topConceptOf scheme:concepts ;
  skos:prefLabel "planted owned label"@en .

concept:planted-borrower a skos:Concept ;
  skos:inScheme scheme:concepts ;
  skos:topConceptOf scheme:concepts ;
  skos:prefLabel "planted borrower"@en ;
  skos:altLabel "planted owned label"@en .
