# A repo fact has no backing to show, and still returns its row.
# query: claim planted-fact
# expect: claim:planted-fact

@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#> .
@prefix model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

claim:planted-fact a model:RepoFact ;
  dcterms:subject concept:landing-point ;
  dcterms:description "Planted: a fact about the repository."@en .
