# An assumed observation and an unattributed decision are listed; a measured observation and an
# attributed decision are not.
# query: weak
# expect: claim:planted-guess claim:planted-nameless

@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#> .
@prefix model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

claim:planted-guess a model:Observation ;
  dcterms:subject concept:focus-ring ;
  dcterms:description "Planted: planted-guess."@en ;
  model:basis model:assumed .

claim:planted-nameless a model:Decision ;
  dcterms:subject concept:not-applicable ;
  dcterms:description "Planted: planted-nameless."@en ;
  model:basis model:unattributed .

claim:planted-measured a model:Observation ;
  dcterms:subject concept:focus-ring ;
  dcterms:description "Planted: planted-measured."@en ;
  prov:wasGeneratedBy [ a model:Measurement ; model:method "Planted: looked in a real browser."@en ] .

claim:planted-decided a model:Decision ;
  dcterms:subject concept:not-applicable ;
  dcterms:description "Planted: planted-decided."@en ;
  prov:wasAttributedTo <https://andyfitzgeraldconsulting.com/#person> .
