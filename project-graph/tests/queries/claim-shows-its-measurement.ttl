# A measured claim: the method, the date and the tool all appear, and so does the comment citing it.
# query: claim planted-measured
# expect: claim:planted-measured
# expect established: measured: Planted: read in headless Chrome. (2026-10-17), using concept:headless-chrome
# expect cited: web/src/c.css:2

@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#> .
@prefix model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

claim:planted-measured a model:Observation ;
  dcterms:subject concept:focus-ring ;
  dcterms:description "Planted: planted-measured."@en ;
  prov:wasGeneratedBy [ a model:Measurement ; model:method "Planted: read in headless Chrome."@en ; dcterms:date "2026-10-17"^^xsd:date ; prov:used concept:headless-chrome ] .

[] a model:CodeLocation ;
  model:path "web/src/c.css" ;
  model:line 2 ;
  model:cites claim:planted-measured .
