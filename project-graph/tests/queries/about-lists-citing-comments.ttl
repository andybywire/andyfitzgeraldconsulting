# One claim cited by two comments in different files; both appear, as file:line.
# query: about landing-point
# expect: claim:planted-cited
# expect cited: web/src/a.css:3
# expect cited: docs/b.md:9

@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#> .
@prefix model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

claim:planted-cited a model:Observation ;
  dcterms:subject concept:landing-point ;
  dcterms:description "Planted: planted-cited."@en ;
  model:basis model:assumed .

[] a model:CodeLocation ;
  model:path "web/src/a.css" ;
  model:line 3 ;
  model:cites claim:planted-cited .

[] a model:CodeLocation ;
  model:path "docs/b.md" ;
  model:line 9 ;
  model:cites claim:planted-cited .
