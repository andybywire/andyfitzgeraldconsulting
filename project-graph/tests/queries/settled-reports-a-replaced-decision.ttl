# A decision a later one replaced is overturned, and the one that replaced it stands.
# query: settled not-applicable
# expect: claim:planted-new-choice claim:planted-old-choice
# expect status: overturned
# expect status: standing

@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#> .
@prefix model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

claim:planted-old-choice a model:Decision ;
  dcterms:subject concept:not-applicable ;
  dcterms:description "Planted: the earlier choice."@en ;
  model:basis model:unattributed .

claim:planted-new-choice a model:Decision ;
  dcterms:subject concept:not-applicable ;
  dcterms:description "Planted: the choice that replaced it."@en ;
  prov:wasAttributedTo <https://andyfitzgeraldconsulting.com/#person> ;
  dcterms:date "2026-01-31"^^xsd:date ;
  prov:wasGeneratedBy [ prov:invalidated claim:planted-old-choice ] .
