# A claim about "hiding", one about "not applicable" (narrower), and one about "focus ring"
# (unrelated). Asking about hiding must find the first two and leave out the third.
# query: about hiding
# expect: claim:planted-about-hiding claim:planted-about-not-applicable

@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#> .
@prefix model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

claim:planted-about-hiding a model:Observation ;
  dcterms:subject concept:hiding ;
  dcterms:description "Planted: planted-about-hiding."@en ;
  model:basis model:assumed .

claim:planted-about-not-applicable a model:Observation ;
  dcterms:subject concept:not-applicable ;
  dcterms:description "Planted: planted-about-not-applicable."@en ;
  model:basis model:assumed .

claim:planted-about-focus-ring a model:Observation ;
  dcterms:subject concept:focus-ring ;
  dcterms:description "Planted: planted-about-focus-ring."@en ;
  model:basis model:assumed .
