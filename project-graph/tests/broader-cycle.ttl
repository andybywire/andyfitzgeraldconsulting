# Two concepts, each broader than the other.
# expect: violation "its own ancestor"

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix scheme: <https://andyfitzgeraldconsulting.com/ns/project-graph/> .

concept:planted-cycle-a a skos:Concept ;
  skos:inScheme scheme:concepts ;
  skos:broader concept:planted-cycle-b ;
  skos:prefLabel "planted cycle a"@en .

concept:planted-cycle-b a skos:Concept ;
  skos:inScheme scheme:concepts ;
  skos:broader concept:planted-cycle-a ;
  skos:prefLabel "planted cycle b"@en .
