# An observation that is both measured and assumed.
# expect: violation "An observation says how it is known"

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#> .
@prefix model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

claim:planted-both a model:Observation ;
  dcterms:subject concept:focus-ring ;
  dcterms:description "Planted: both."@en ;
  prov:wasGeneratedBy [ a model:Measurement ; model:method "Planted: looked in a browser."@en ] ;
  model:basis model:assumed .
