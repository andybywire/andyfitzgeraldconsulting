# An observation given the decision's basis, model:unattributed.
# expect: violation "An observation's only possible basis is model:assumed"

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#> .
@prefix claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#> .
@prefix model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

claim:planted-wrong-basis a model:Observation ;
  dcterms:subject concept:focus-ring ;
  dcterms:description "Planted: wrong basis."@en ;
  model:basis model:unattributed .
