# Observations whose only evidence is an automated browser: every measurement behind them used
# one. The lesson of 2026-09-30, when headless Chrome and the Browser pane both reported no focus
# ring and real browsers drew one.
#
# Reads prov:used, and follows skos:broader to concept:automated-browser, so a tool added under it
# later is covered without changing this query. A claim with even one measurement that used no
# automated browser is left out.
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#>
PREFIX claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#>
PREFIX model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#>

SELECT ?claim ?status ?description (GROUP_CONCAT(DISTINCT STR(?tool); SEPARATOR=" ") AS ?tools)
  (GROUP_CONCAT(DISTINCT ?where; SEPARATOR=", ") AS ?cited)
WHERE {
  ?claim a model:Observation ;
    dcterms:description ?description ;
    prov:wasGeneratedBy ?measurement .
  ?measurement prov:used ?tool .
  ?tool skos:broader* concept:automated-browser .
  FILTER NOT EXISTS {
    ?claim prov:wasGeneratedBy ?other .
    FILTER NOT EXISTS { ?other prov:used/skos:broader* concept:automated-browser }
  }
  OPTIONAL { ?overturning prov:invalidated ?claim }
  BIND(IF(BOUND(?overturning), "overturned", "standing") AS ?status)
  OPTIONAL {
    ?location model:cites ?claim ; model:path ?file ; model:line ?line .
    BIND(CONCAT(?file, ":", STR(?line)) AS ?where)
  }
}
GROUP BY ?claim ?status ?description
ORDER BY ?claim
