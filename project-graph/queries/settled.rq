# The decisions about a concept or any narrower one: who made each and when, or that nobody is
# named, and whether it still stands. Task T4's question: is this already decided?
#
# Reads prov:wasAttributedTo and dcterms:date on decisions.
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX concept: <https://andyfitzgeraldconsulting.com/ns/project-graph/concepts#>
PREFIX claim: <https://andyfitzgeraldconsulting.com/ns/project-graph/claims#>
PREFIX model: <https://andyfitzgeraldconsulting.com/ns/project-graph/model#>

SELECT ?claim ?decided ?status ?description (GROUP_CONCAT(DISTINCT ?where; SEPARATOR=", ") AS ?cited)
WHERE {
  ?claim a model:Decision ;
    dcterms:subject/skos:broader* {{concept}} ;
    dcterms:description ?description .
  OPTIONAL { ?claim prov:wasAttributedTo ?who }
  OPTIONAL { ?claim dcterms:date ?date }
  BIND(IF(BOUND(?who), CONCAT("by ", STR(?who), IF(BOUND(?date), CONCAT(" on ", STR(?date)), "")), "unattributed") AS ?decided)
  OPTIONAL { ?overturning prov:invalidated ?claim }
  BIND(IF(BOUND(?overturning), "overturned", "standing") AS ?status)
  OPTIONAL {
    ?location model:cites ?claim ; model:path ?file ; model:line ?line .
    BIND(CONCAT(?file, ":", STR(?line)) AS ?where)
  }
}
GROUP BY ?claim ?decided ?status ?description
ORDER BY ?claim
