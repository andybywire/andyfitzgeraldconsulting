---
/**
 * The AF monogram. Copied from web/_includes/icons/afc.svg — one `evenodd` path
 * in a 100×100 box, unchanged except for dropping `fill="none"` off the <svg>.
 *
 * ── WHY IT IS INLINE, AND WHY THAT MATTERS ───────────────────────────────────
 *
 * The path is ONE subpath for the disc plus subpaths for the A and the F, with
 * `fill-rule="evenodd"`. So the letters are HOLES, not shapes: the disc gets the
 * fill and the letterforms show whatever is painted behind them. Two consequences,
 * both good, and neither reachable from an <img>:
 *
 *   1. The disc themes from `currentColor`, so it follows the color role of its
 *      context — accent in the masthead, `text-on-accent` if it ever lands on a
 *      band, with nothing here to change.
 *   2. The letters are never a color at all. They are the ground behind the mark,
 *      so the counter-shapes are automatically right on the page ground, on a
 *      card surface, and in either theme, with nothing to keep in sync. Hardcoding
 *      them white would be wrong in dark mode the moment it shipped.
 *
 * The cost is ~1.6 KB of path data in every HTML document. That is the price of
 * the two properties above; a sprite or <use> reference would only buy it back at
 * the cost of a second request or a second document to keep in step.
 *
 * ── ACCESSIBILITY ────────────────────────────────────────────────────────────
 *
 * Decorative by default: `aria-hidden`, `focusable="false"`. The mark almost
 * always sits inside a home link that ALSO carries the wordmark as real text, so
 * a title here would make the link announce its name twice. If it is ever used
 * without adjacent text, the accessible name belongs on the enclosing link, not
 * on this SVG.
 */
interface Props {
  class?: string
  /* Spread onto the root, which is also what lets a parent component style this
     one: Astro passes its style scope down as a prop and it only reaches the DOM
     if the component forwards rest. */
  [key: string]: unknown
}

const {class: className, ...rest}: Props = Astro.props
---

<svg
  class:list={['logo', className]}
  viewBox="0 0 100 100"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
  {...rest}
>
  <path
    fill-rule="evenodd"
    clip-rule="evenodd"
    d="M50 100C77.6142 100 100 77.6142 100 50C100 22.3858 77.6142 0 50 0C22.3858 0 0 22.3858 0 50C0 77.6142 22.3858 100 50 100ZM12.8 66.76V70H26.84V66.76H24.5C23.74 66.76 23.18 66.56 22.82 66.16C22.5 65.76 22.34 65.22 22.34 64.54C22.34 64.18 22.38 63.76 22.46 63.28C22.54 62.8 22.64 62.34 22.76 61.9C22.88 61.46 22.96 61.08 23 60.76L24.32 55.9H36.68L38.36 61.66C38.44 61.86 38.52 62.14 38.6 62.5C38.68 62.86 38.74 63.24 38.78 63.64C38.86 64 38.9 64.34 38.9 64.66C38.9 65.42 38.66 65.96 38.18 66.28C37.74 66.6 37.22 66.76 36.62 66.76H34.58V70H53.24V66.76H52.64C52 66.76 51.42 66.64 50.9 66.4C50.38 66.16 49.9 65.76 49.46 65.2C49.06 64.64 48.72 63.92 48.44 63.04L37.46 27.16H28.88L17.54 62.44C17.18 63.6 16.78 64.5 16.34 65.14C15.94 65.74 15.48 66.16 14.96 66.4C14.48 66.64 13.92 66.76 13.28 66.76H12.8ZM35.54 52.18H25.52L28.82 40.72C28.98 40.12 29.14 39.5 29.3 38.86C29.5 38.22 29.68 37.58 29.84 36.94L30.32 35.02C30.48 34.38 30.62 33.76 30.74 33.16C30.9 34 31.08 34.86 31.28 35.74C31.48 36.58 31.68 37.44 31.88 38.32L32.6 40.96L35.54 52.18ZM54.4827 66.76V70H74.9427V66.76H72.0027C71.3227 66.76 70.7427 66.66 70.2627 66.46C69.8227 66.22 69.5027 65.84 69.3027 65.32C69.1027 64.8 69.0027 64.14 69.0027 63.34V50.8H81.4227V47.14H69.0027V30.88H77.2227C77.7827 30.88 78.3027 31.04 78.7827 31.36C79.3027 31.64 79.7227 32.1 80.0427 32.74C80.4027 33.38 80.6227 34.24 80.7027 35.32L81.0027 38.26H85.0827L84.7827 27.16H54.4827V30.4H56.8827C57.3227 30.4 57.7227 30.5 58.0827 30.7C58.4827 30.9 58.7827 31.26 58.9827 31.78C59.2227 32.26 59.3427 32.92 59.3427 33.76V63.46C59.3427 64.3 59.2227 64.96 58.9827 65.44C58.7827 65.92 58.4627 66.26 58.0227 66.46C57.5827 66.66 57.0027 66.76 56.2827 66.76H54.4827Z"
  ></path>
</svg>

<style>
  .logo {
    /* Square, so one dimension is enough — but `height` has to be stated because
       base.css sets `svg { height: auto }`, and `auto` on an SVG with a viewBox
       resolves from the aspect ratio only if the inline size is definite. Saying
       both is one line cheaper than reasoning about when it is. */
    inline-size: var(--logo-size);
    block-size: var(--logo-size);

    /* NO COLOR IS SET HERE, for the same reason base.css sets none on Lucide
       icons: the mark takes the color of its context, and its consumer names the
       role. The masthead sets `color: var(--color-accent)`.
       Binding a default here would look harmless and would not be: a consumer's
       override and this rule would BOTH be one class plus the scope attribute —
       (0,2,0) each — so which won would come down to the order Astro happens to
       emit the two stylesheets in, not to anything either file states.
       `fill` inherits from here down to the path, which carries no fill of its
       own. That is the whole mechanism. */
    fill: currentColor;
  }
</style>
