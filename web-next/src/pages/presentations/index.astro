---
/**
 * The Presentations index — phase 4, and the Presentation branch's only index.
 *
 * ── A COMPOSITION OF FOUR SHARED COMPONENTS ──────────────────────────────────
 *
 * <FacetFilters>, <CardMasonry>, <ResultsFooter> and the behaviour in
 * scripts/card-index.ts are all shared with the Insights index, which is where every one
 * of them was written before this page existed. What is this page's own is the query,
 * how a presentation becomes a card, the venue line, the derived tags, and placement.
 *
 * The filters shipped one step after the rest of the page, deliberately. On four cards
 * the mechanism has almost nothing to cut — five of eight topic chips reduce the set to
 * one — so the first version went out without them rather than force the extraction
 * early. The extraction then happened on its own terms, with both consumers in view,
 * which is why <FacetFilters> and <ResultsFooter> arrived complete rather than as a
 * second copy.
 *
 * The corpus it filters, measured 2026-09-09:
 *
 *   topics   Content Modeling 3, Taxonomy 2, Mental Models 2, then FIVE at 1 each
 *   genres   Talk 2, Keynote 1, Interview 1
 *
 * The board's chips are sketched at Insights volume — "Knowledge graphs (8)", "Select
 * all (33)" — which is the collection the mechanism was designed for and not this one.
 * Worth remembering before reading much into how sparse the rows look.
 *
 * ── THE GRID WAS A ROW GRID FOR ONE STEP, AND THE ESTIMATE WAS WRONG ─────────
 *
 * Worth keeping because the mistake was in the measurement, not the reasoning. This
 * first shipped as a plain row grid, on the argument that duplicating Insights' measuring
 * script was the thing the extraction exists to prevent. That was right about the
 * duplication and wrong about the cost: the slack under card 1 was ESTIMATED at 58px and
 * MEASURED on screen at ~117px, because "Yes, And…" wraps to three lines rather than two
 * and sets the row height for everything beside it.
 *
 * <CardMasonry> came out of that, with this page as its first consumer — writing the copy
 * that survives rather than one to be deleted. Insights has since adopted it, along with
 * the other two components, so there is now exactly one implementation of each.
 */
import {loadQuery} from '../../sanity/load-query'
import {PRESENTATIONS_INDEX_QUERY} from '../../sanity/queries/presentations'
import {SINGLETON_HEADER_QUERY, SINGLETON_RSS_TOUCH_QUERY} from '../../sanity/queries/singletons'
import {formatLocation} from '../../lib/location'
import {slugify} from '../../lib/slug'
import {facetGroups} from '../../lib/facets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Band from '../../components/Band.astro'
import Grid from '../../components/Grid.astro'
import Masthead from '../../components/Masthead.astro'
import Footer from '../../components/Footer.astro'
import PageHeader from '../../components/PageHeader.astro'
import PresentationCard from '../../components/cards/PresentationCard.astro'
import type {CardTag} from '../../components/cards/PresentationCard.astro'
import CardMasonry from '../../components/cards/CardMasonry.astro'
import FacetFilters from '../../components/FacetFilters.astro'
import ResultsFooter from '../../components/ResultsFooter.astro'
import RssBand from '../../components/bands/RssBand.astro'
import GetInTouchBand from '../../components/bands/GetInTouchBand.astro'

/* Three independent fetches, so they go together rather than in series. The header and
   the bands are separate queries because a singleton's `heroCopy` plus two band
   messages is three Portable Text arrays in one projection — past the shape
   singletons.ts names as the ClientReturn ceiling. Split costs no wall time here. */
const [page, bands, presentations] = await Promise.all([
  loadQuery(SINGLETON_HEADER_QUERY, {slug: 'presentations'}),
  loadQuery(SINGLETON_RSS_TOUCH_QUERY, {slug: 'presentations'}),
  loadQuery(PRESENTATIONS_INDEX_QUERY),
])

/* Loud rather than quiet, matching the other index pages. The singleton is content, so
   it can be unpublished or re-slugged in the Studio — and a page that silently lost its
   own title and lead would look like a styling bug rather than a missing document. That
   is not hypothetical here: this document replaced one slugged `speaking` on
   2026-09-09, and a page addressing the old slug would have failed exactly this way. */
if (!page) throw new Error('[presentations/index] no singleton with slug "presentations"')

/**
 * One flat shape per card, in date order, resolved here so the template does no data
 * work beyond choosing a component.
 *
 * The query filters on `defined(slug.current)`, but TypeGen types a projected slug as
 * `string | null` because it cannot see the filter — so this narrows rather than
 * asserting, exactly as the other index pages do.
 */
const cards = presentations.flatMap((item) => {
  if (!item.slug) return []

  /*
   * ── THE VENUE LINE: THE FIRST DELIVERY, NAME AND PLACE ────────────────────
   *
   * The board draws "Button Events • Online" — the event's name, then its location.
   * `formatLocation` composes the place half and owns the whole display rule, including
   * the one that matters most: `online` is read FIRST, because Sanity's conditional
   * `hidden` stops a field being edited rather than stored. Two of today's four are
   * online and BOTH still carry a stale `country: "USA"`, so anything inferring
   * "in person" from a present country would print a location for a podcast.
   *
   * Joined in JS rather than in the template. The separator is then part of a single
   * string, which sidesteps the whitespace-sensitive text node that made <Eyebrow> draw
   * its pipe with generated content — Prettier reformats `{…}` expression blocks on
   * every `pnpm format` and `<!-- prettier-ignore -->` does not apply to them.
   */
  const place = formatLocation(item.venue)
  const venue = [item.venue?.name, place].filter(Boolean).join(' • ')

  /*
   * ── THE TAGS ARE DERIVED, AND ORDERED SMALLEST-CONTEXT FIRST ──────────────
   *
   * Every one is a fact the query already knows; none is authored, and none is
   * clickable. Board order on the one card that shows three is `+1, transcript, audio`,
   * which this follows, with `video` beside `audio` and `slides` last.
   *
   * `+N` COUNTS THE DELIVERIES THE VENUE LINE DID NOT NAME, so it is `eventCount - 1`
   * rather than the count itself — it modifies the line directly above it. The board
   * also prints an inline "(+1)" after the location; that is leftover sketching,
   * superseded by this chip, and deliberately not reproduced.
   *
   * `recordingKinds` comes back as the flattened `kind` of every recording across every
   * event, so it can hold duplicates — three deliveries of one talk can each carry
   * audio. A Set collapses them to the question the tag actually asks: is there audio
   * at all. It is also typed `("audio" | "video" | null)[]`, because the query's
   * `defined()` filter is invisible to TypeGen, hence the Boolean narrowing.
   *
   * On today's corpus this produces, in order: ["video"], ["slides"],
   * ["transcript", "audio"], ["+2", "transcript"] — so every tag kind is exercised.
   */
  const kinds = new Set((item.recordingKinds ?? []).filter(Boolean))
  const extra = (item.eventCount ?? 0) - 1

  const tags: CardTag[] = [
    ...(extra > 0
      ? [{label: `+${extra}`, hint: `${extra} more ${extra === 1 ? 'venue' : 'venues'}`}]
      : []),
    ...(item.hasTranscript ? [{label: 'transcript'}] : []),
    ...(kinds.has('audio') ? [{label: 'audio'}] : []),
    ...(kinds.has('video') ? [{label: 'video'}] : []),
    ...(item.hasDeck ? [{label: 'slides'}] : []),
  ]

  return [
    {
      id: item._id,
      href: `/presentations/${item.slug}/`,
      title: item.title ?? 'Untitled',
      genre: item.genre,
      date: item.pubDate,
      venue: venue || null,
      /* The poster ladder is already resolved in the query — the presentation's own,
         else the first recording carrying one. Null is a real outcome and is what
         leaves the card unboxed; see PresentationCard. */
      poster: item.poster,
      tags,

      /*
       * ── THE FACETS, AS SLUGS, ON THE CARD ITSELF ───────────────────────────
       *
       * There is no JSON facet index and there does not need to be one: every document
       * renders, so the DOM already holds the complete topic and genre sets that live
       * counts need. It comes back when show-more stops rendering everything.
       *
       * SPACE-SEPARATED, which is a real choice: `~=` matches one word of a
       * space-separated attribute natively, so `[data-topics~="taxonomy"]` is a
       * selector rather than a parse. The script never splits a string to test
       * membership, and these are clean slugs in an attribute — never rendered text —
       * so preview mode's stega-encoded metadata cannot land in them.
       */
      genreSlug: item.genre ? slugify(item.genre) : null,
      topicSlugs: (item.topics ?? [])
        .filter((topic): topic is string => Boolean(topic))
        .map(slugify),
    },
  ]
})

/**
 * ── GENRE SHOWS ONLY THE PRESENTATION BRANCH, AND NOTHING ENFORCES IT ────────
 *
 * `facetGroups` tallies whatever the rows contain, and these rows are the result of a
 * query selecting `_type == "presentation"` — so the genres are exactly the ones this
 * corpus uses, today Talk, Keynote and Interview. There is no allow-list and there
 * should not be one: an allow-list would be a second place for the vocabulary to live,
 * and it would go stale the day a Workshop or a Panel is published.
 *
 * WHAT IT RESTS ON is the consistency invariant CLAUDE.md records — a document's genre
 * sits under the top concept matching its structural family. Four documents violated it
 * while `presentation` did not exist, all stored as `article`; they were re-typed and
 * the corpus measured clean on 2026-09-09. If one regressed, a Document-branch genre
 * would appear as a chip here, which is a content problem this page would surface rather
 * than hide. That is the right way round.
 */
const facets = facetGroups(presentations)
---

<BaseLayout title={page.title ?? 'Presentations'} description={page.lede ?? undefined}>
  <Masthead />

  <main>
    <Band as="section" class="index-band">
      <Grid>
        {
          /*
          ── FULL WIDTH, NOT THE BOARD'S 656 ──────────────────────────────────

          The board draws the Page Header at 656 (`--col-main`), and DESIGN.md
          overrides it: "the masonry-and-filters pattern has no rail, so a header
          constrained to `--col-main` reserves space for nothing… on these pages the
          header takes `--col-full`, and the lede takes `max-width: 66ch`." That rule
          names this page explicitly, and the authority chain puts DESIGN.md above the
          boards on a rule. The cap lives in <PageHeader>, so nothing is restated here.
        */
        }
        <PageHeader title={page.title ?? 'Presentations'} lede={page.heroCopy} />

        {
          /*
          `as="h2"` — the page has one h1 and no other headings, so the card titles sit
          directly under it. That stays correct when the facet groups arrive: their
          "Topics" and "Genres" headings are h2 as well, and Insights settled that a
          flat run beats dropping cards to h3, which would situate every title as
          subordinate to *Genres* rather than to the page.
        */
        }
        {
          /*
          The same controls the Insights index carries, from the same component — which
          owns its own grid placement, since both boards draw the identical 7 + skip-1 +
          4 split. The vocabulary is this page's own; see the note on `facets`.
        */
        }
        <FacetFilters facets={facets} basePath="/presentations/" label="Filter presentations" />

        {
          /*
          `truncate` even though this corpus is far below one reveal step of 24. The
          attribute is what the pre-paint rule keys on, and it is correct the day the
          corpus passes 24 rather than something to remember to add then. It is inert
          until then — `nth-child(n + 25)` matches nothing at four cards.
        */
        }
        <CardMasonry class="masonry" truncate>
          {
            cards.map((card) => (
              <PresentationCard
                as="h2"
                data-genre={card.genreSlug}
                data-topics={card.topicSlugs.length ? card.topicSlugs.join(' ') : undefined}
                href={card.href}
                title={card.title}
                genre={card.genre}
                date={card.date}
                venue={card.venue}
                poster={card.poster}
                tags={card.tags}
              />
            ))
          }
        </CardMasonry>

        {
          /*
          ── THE BOTTOM BAR ───────────────────────────────────────────────────

          Reads "Displaying all 4 presentations" today and wires up for growth: the
          component ships both reveal controls `hidden`, and the script un-hides them
          only once the corpus exceeds a step — `revealed + STEP >= cards.length` is
          false at 4, so neither shows. Nothing here needs changing when it does.
        */
        }
        <ResultsFooter total={cards.length} noun={{one: 'presentation', many: 'presentations'}} />
      </Grid>
    </Band>

    {
      /*
      Owns its own <Band tone="accent" space="section">, so it is appended to the page
      stack rather than placed on the grid — matching the board, where the RSS CTA is a
      full-bleed 1440-wide instance.

      Its content resolves through the band ladder in the query, and the page never
      learns which rung produced it. Today that is rung ONE: the singleton sets its own
      `bandRss`, which is why this reads "Follow Presentations with RSS" rather than the
      site default's generic copy.

      Rendered only when the ladder produced something. There is a site default, so the
      only way to reach null is Settings carrying no RSS band at all — in which case a
      heading and a button over empty space would be worse than no band.
    */
    }
    {
      bands?.rssBand && (
        <RssBand
          title={bands.rssBand.title}
          message={bands.rssBand.message}
          buttonTarget={bands.rssBand.buttonTarget}
        />
      )
    }

    {
      /*
      ── THIS ONE OWNS NO FRAME, SO THE PAGE SUPPLIES IT ──────────────────────

      The inverse of <RssBand> directly above, and the difference is the design rather
      than an inconsistency: <GetInTouchBand> is a form that sits in the prose column,
      so it takes a <Band> and a <Grid> from its host and is placed at `--col-main` —
      which is what the board draws, a full-bleed frame with the Contact instance at
      x=222, width 656. `pages/[slug].astro` places it the same way for the same reason.

      Resolves at rung THREE, the Settings default, since the singleton sets no
      `bandGetInTouch` of its own. `bandCopy` is true there, so the band carries its own
      h2 and message above the form rather than relying on a host page's title.
    */
    }
    {
      bands?.touchBand && (
        <Band as="section">
          <Grid>
            <GetInTouchBand
              class="index-touch-band"
              message={bands.touchBand.message}
              bandCopy={bands.touchBand.bandCopy}
            />
          </Grid>
        </Band>
      )
    }
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Full width, per DESIGN.md's rule for a masonry index with no rail. The lede's 66ch
     cap is <PageHeader>'s own; this states only where the header sits on the grid,
     which is a fact about the PAGE. Reaching the component's root through the scope
     attribute Astro passes down. */
  .page-header {
    grid-column: var(--col-full);
  }

  /*
   * ── ALL THIS PAGE OWNS IS WHERE THE GRID SITS ───────────────────────────────
   *
   * The column ladder, the gaps and the measured spans belong to <CardMasonry>, which
   * defaults to the 3-column rung DESIGN.md → Card grids specifies for "Insights /
   * Presentations index" — 3 x 316 + 2 x 24 closing the 996 content width exactly, as
   * the board draws at x 0 / 340 / 680. So no `columns` prop is passed.
   *
   * Placement stays here for the reason it stays on every page: where a thing sits on
   * the grid is a fact about the PAGE. Reaching the component's root through the scope
   * attribute Astro passes down.
   */
  .masonry {
    grid-column: var(--col-full);
  }

  /* Same full-width placement, and <Grid>'s `rhythm-heading-major` row gap is what
     separates it from the masonry above. */
  .results-footer {
    grid-column: var(--col-full);
  }

  /* The form sits on the prose measure, not the full content width — the board's 656.
     <Band> supplies the vertical space, so nothing here sets it. */
  .index-touch-band {
    grid-column: var(--col-main);
  }
</style>
