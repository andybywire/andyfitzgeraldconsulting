# Copy to `.env` beside contact.php on the droplet. NEVER commit the real file.
#
# The deploy must write this as 640 owned by the web group, NOT 644. The live site's
# equivalent is world-readable today with these exact secrets in it, which CLAUDE.md
# records as a live security issue rather than a migration note. This directory is also
# deployed OUTSIDE the web root, so nginx never serves it even if the mode is wrong.
#
# RECAPTCHA_SECRET is deliberately absent: spam protection is now a honeypot plus nginx
# rate limiting, so there is no third-party verification step and no key to leak.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# The authenticated Gmail account messages are sent AS. Falls back to the recipient
# address in contact.php when unset.
GMAIL_FROM=
