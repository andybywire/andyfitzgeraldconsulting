{
  "compilerOptions": {
    // ES2022 rather than studio/'s ES2017: Node 24 and every browser the Studio supports are well
    // past it, and the old target predates this repo's current floor by several years.
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    // studio/tagger/ imports its own files with a `.ts` extension, because plain Node runs them
    // too, under type stripping, and resolves no extensionless path: the recommendations
    // research imports the tagger, and its checks run outside the Studio. web/ allows the same
    // through Astro's strict config, for web/src/lib/related.ts.
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
