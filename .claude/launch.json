{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "url": "http://localhost:4321",
      "port": 4321
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev:preview"],
      "port": 4321
    },
    {
      "name": "studio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "studio", "dev"],
      "port": 3030
    },
    {
      "name": "web-ssr",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "HOST=127.0.0.1",
        "PORT=8081",
        "NODE_ENV=production",
        "node",
        "--env-file=web/.env",
        "--max-old-space-size=128",
        "web/dist/server/entry.mjs"
      ],
      "port": 8081
    }
  ]
}
