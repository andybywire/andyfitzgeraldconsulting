studio/schema.json

# The recommendations research scripts' output: JSON written by JSON.stringify, so formatting it
# here would only be undone by the next run. Whole folders rather than the files that fail today,
# since a later run's file can fail where this one passed. Note that checks.yml skips a push that
# touches only docs/, so a file here that breaks Prettier fails the NEXT push that touches code,
# not its own. That is how reverse-blocks.json sat unnoticed on main (2026-11-19).
docs/recommendations-research/corpus.json
docs/recommendations-research/reverse-blocks.json
docs/recommendations-research/backups/
docs/recommendations-research/scores/
docs/recommendations-research/tagsets/
# The ranker's golden fixture, written by docs/recommendations-research/golden-fixture.mjs for
# the same reason. It sits in web/ rather than docs/, so unlike the files above, a Prettier
# failure in it would fail its own push.
web/src/lib/related.golden.json

# Written by `sanity dev`. studio/.gitignore already ignores it, but Prettier reads only the ROOT
# .gitignore, never a nested one — so a local `prettier --check .` failed on it while CI, which
# never has the directory, would not.
studio/.sanity/

# Claude Code worktrees: whole checkouts of this repo, nested inside it. Git ignores them through
# .git/info/exclude, which Prettier does not read — so without this, `pnpm format` in the main
# checkout would rewrite files in a worktree someone else is in the middle of editing.
.claude/worktrees/

# Composer writes this file too, on `composer require`, by its own rules. Two writers of one file
# is the churn studio/sanity.cli.ts records for TypeGen, and Composer is the one that owns it.
web/server/composer.json

# Lockfiles
pnpm-lock.yaml
package-lock.json
